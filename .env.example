# PostgreSQL connection string.
# Locally: postgresql://postgres:postgres@localhost:5432/gc_crm
# On Railway: provided automatically as ${{ Postgres.DATABASE_URL }} when you
# add the Postgres plugin and reference it from the web service's variables.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gc_crm"

# Random secret used to sign auth session tokens.
# Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Public URL of the deployed app (used by NextAuth for callbacks).
# Locally: http://localhost:3000
# On Railway: https://<your-app>.up.railway.app
NEXTAUTH_URL="http://localhost:3000"

# Credentials for the default admin account created by `npm run db:seed`.
# Change these before seeding a production database.
SEED_ADMIN_EMAIL="admin@godwincap.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
